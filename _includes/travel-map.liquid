<section class="travel-atlas" aria-labelledby="travel-map-title">
  <h2 id="travel-map-title">Places I've been</h2>
  <div class="travel-atlas-tabs" role="tablist" aria-label="Travel map regions">
    {% assign regions = 'World,Asia,Europe' | split: ',' %}
    {% for region in regions %}
      <button
        type="button"
        role="tab"
        id="travel-tab-{{ region | downcase }}"
        aria-controls="travel-map-panel"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        data-region="{{ region }}"
      >
        {{ region }}
      </button>
    {% endfor %}
  </div>
  <div class="travel-atlas-panel" id="travel-map-panel" role="tabpanel" aria-labelledby="travel-tab-world">
    <div class="travel-atlas-frame" data-world-url="{{ '/assets/json/travel-world.json' | relative_url }}">
      <svg viewBox="0 0 960 500" role="group" aria-label="Map of visited places"></svg>
      <div class="travel-atlas-tooltip" role="status" aria-live="polite" hidden></div>
      <p class="travel-atlas-fallback">Loading map…</p>
    </div>
  </div>
  <div class="travel-atlas-caption">
    <span class="travel-atlas-count" aria-live="polite">{{ site.data.travel | size }} places across Asia and Europe</span>
    <span class="travel-atlas-legend"
      ><span class="travel-dot travel-dot-asia"></span> Asia <span class="travel-dot travel-dot-europe"></span> Europe</span
    >
  </div>
  <details class="travel-atlas-places">
    <summary>All visited places</summary>
    <ul>
      {% for place in site.data.travel %}
        <li>
          <button type="button" data-place="{{ forloop.index0 }}">{{ place.name }}</button>
        </li>
      {% endfor %}
    </ul>
  </details>
  <script type="application/json" id="travel-map-data">
    {{ site.data.travel | jsonify }}
  </script>
</section>
<link rel="stylesheet" href="{{ '/assets/css/travel-map.css' | relative_url }}">
<script defer src="{{ '/assets/js/travel-libs/d3.min.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/travel-libs/topojson-client.min.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/travel-map.js' | relative_url }}"></script>
